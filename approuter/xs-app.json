{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "^/odata/v4/KsefService/(.*)$",
      "target": "/odata/v4/KsefService/$1",
      "destination": "ainvoicer-cap",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/rap-ui/(.*)$",
      "target": "/sap/opu/odata4/sap/zui_ainv_inv_h_o4/srvd/sap/zui_ainv_inv_h_o4/0001/$1",
      "destination": "AINV_H01_UI_USER",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "destination": "ui5",
      "authenticationType": "none"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
