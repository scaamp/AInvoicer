<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<artifactId>cap-java-parent</artifactId>
		<groupId>customer</groupId>
		<version>${revision}</version>
	</parent>

	<artifactId>cap-java</artifactId>
	<packaging>jar</packaging>

	<name>cap-java</name>

	<!-- ACTUAL DEPENDENCIES -->
	<dependencies>
		<dependency>
			<groupId>pl.akmf.ksef-sdk</groupId>
			<artifactId>ksef-client</artifactId>
			<version>${ksef.sdk.version}</version>
		</dependency>
		<!-- SDK używa Jackson 2; Gradle implementation publikuje tę zależność jako runtime. -->
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
		</dependency>
		<!-- CDS SPRING BOOT STARTER -->
		<dependency>
			<groupId>com.sap.cds</groupId>
			<artifactId>cds-starter-spring-boot</artifactId>
		</dependency>

		<!-- Implementacja natywnych CAP Remote Services dla OData V4. -->
		<dependency>
			<groupId>com.sap.cds</groupId>
			<artifactId>cds-feature-remote-odata</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Publiczny typ błędu HTTP pozwala odczytać Retry-After bez parsowania komunikatów. -->
		<dependency>
			<groupId>com.sap.cloud.sdk.datamodel</groupId>
			<artifactId>odata-client</artifactId>
		</dependency>

		<!-- Integracja SAP Cloud SDK z SAP BTP Destination Service na Cloud Foundry. -->
		<dependency>
			<groupId>com.sap.cloud.sdk.cloudplatform</groupId>
			<artifactId>scp-cf</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Spring Security: mock users tylko lokalnie/testowo; na BTP walidacja JWT XSUAA (CAP-07, ADR-0006). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- CAP-07: oficjalna integracja CAP Java 5.x z XSUAA/IAS (zastępuje usunięty cds-feature-xsuaa).
		     Aktywuje się wyłącznie przy bindingu usługi xsuaa/identity; mapuje scope bez prefiksu xsappname
		     na role CAP i xs.user.attributes na $user.<attr>. Brak własnej kryptografii JWT. -->
		<dependency>
			<groupId>com.sap.cds</groupId>
			<artifactId>cds-feature-identity</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- SAP Cloud Security Services Integration Library 4.x (Spring Boot 4): walidacja podpisu (JWKS),
		     issuer, audience i ważności tokenu XSUAA. Wersja z java-bom w parent POM. -->
		<dependency>
			<groupId>com.sap.cloud.security</groupId>
			<artifactId>resourceserver-security-spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Offline kontrakt JWT: syntetyczne tokeny i lokalny JWKS (WireMock) z testowym kluczem biblioteki SAP.
		     To NIE jest dowód LIVE XSUAA. -->
		<dependency>
			<groupId>com.sap.cloud.security</groupId>
			<artifactId>java-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>com.sap.cds</groupId>
			<artifactId>cds-adapter-odata-v4</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- CAP-07.1: SAP HANA Cloud (HDI) na Cloud Foundry. CAP tworzy DataSource z bindingu `hana`
		     (auto-konfiguracja aktywna poza profilem default). Pojedyncza zależność zamiast cds-starter-cloudfoundry
		     (ADR-0006: bez multitenancy). Lokalnie i w testach nadal H2; CloudPersistenceGuard blokuje H2 na chmurze. -->
		<dependency>
			<groupId>com.sap.cds</groupId>
			<artifactId>cds-feature-hana</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- H2 wyłącznie lokalnie/testowo. Na CF bez bindingu HANA Spring Boot utworzyłby z niej cichą bazę
		     w pamięci — dlatego CloudPersistenceGuard odmawia startu (poza jawnym trybem identity-smoke). -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Konsola H2 domyślnie OFF; wymaga izolowanego profilu h2-console-local i loopback. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<!-- Wyłącznie osobno zatwierdzony zapis syntetyczny do istniejącego HDI; nigdy zwykłe verify/CI. -->
	<profiles>
		<profile>
			<id>hana-integration</id>
			<build><plugins>
				<plugin><artifactId>maven-surefire-plugin</artifactId><configuration><skipTests>true</skipTests></configuration></plugin>
				<plugin>
					<artifactId>maven-failsafe-plugin</artifactId><version>3.6.0</version>
					<configuration>
						<skipTests>false</skipTests><includes><include>**/HanaPersistenceIT.java</include></includes>
						<systemPropertyVariables><ainv.hana.integration>true</ainv.hana.integration></systemPropertyVariables>
					</configuration>
					<executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
				</plugin>
			</plugins></build>
		</profile>
	</profiles>
	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<!-- SPRING BOOT PLUGIN -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>${spring.boot.version}</version>
				<configuration>
					<skip>false</skip>
				</configuration>
				<executions>
					<execution>
						<id>repackage</id>
						<goals>
							<goal>repackage</goal>
						</goals>
						<configuration>
							<classifier>exec</classifier>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- STEPS TO BUILD CDS MODEL AND GENERATE POJOs -->
			<plugin>
				<groupId>com.sap.cds</groupId>
				<artifactId>cds-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>cds.clean</id>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>

					<execution>
						<id>cds.install-node</id>
						<goals>
							<goal>install-node</goal>
						</goals>
					</execution>

					<execution>
						<id>cds.npm-ci</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>ci</arguments>
						</configuration>
					</execution>

					<execution>
						<id>cds.resolve</id>
						<goals>
							<goal>resolve</goal>
						</goals>
					</execution>

					<execution>
						<id>cds.build</id>
						<goals>
							<goal>cds</goal>
						</goals>
						<configuration>
							<commands>
								<command>build --for java</command>
								<command>deploy --to h2 --with-mocks --dry --out "${project.basedir}/src/main/resources/schema-h2.sql"</command>
							</commands>
						</configuration>
					</execution>

					<execution>
						<id>cds.generate</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<basePackage>cds.gen</basePackage>
							<betterNames>true</betterNames>
							<cqnServiceGetters>true</cqnServiceGetters>
							<linkedInterfaces>true</linkedInterfaces>
							<interfacesForAspects>true</interfacesForAspects>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
