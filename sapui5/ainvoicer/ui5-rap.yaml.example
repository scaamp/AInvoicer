# ABAP-06: szablon READ po przejściu bramki LIVE; endpoint H01 wymaga weryfikacji.
# Skopiuj do ignorowanego ui5-rap.local.yaml. Uzupełnij origin i pathPrefix z bindingu V4 UI.
# Destination `abap` musi zachowywać business usera; bez wspólnego communication usera.
# SRVD: Invoices, InvoiceItems, InvoiceReferences; szczegóły przez _Items/_References.
# manifest: dataMode=rap dopiero po READ/IAM PASS; capabilities.sendInvoice=false.
specVersion: "3.1"
metadata:
  name: ainvoicer
type: application
server:
  customMiddleware:
    - name: fiori-tools-proxy
      afterMiddleware: compression
      configuration:
        ignoreCertError: false
        ui5:
          path: [/resources, /test-resources]
          url: https://ui5.sap.com
        backend:
          - path: /rap-ui
            pathPrefix: /REPLACE_WITH_VERIFIED_V4_UI_SERVICE_PATH
            url: https://replace-with-verified-h01-origin.invalid
            destination: abap
          - path: /odata/v4/KsefService
            url: http://localhost:8080
          # Dotychczasowa niezależna trasa SAP FI Legacy.
          - path: /sap
            url: https://replace-with-verified-legacy-origin.invalid
            destination: REPLACE_WITH_VERIFIED_LEGACY_DESTINATION
