{
  "name": "ainvoicer",
  "version": "0.0.1",
  "description": "AInvoicer is an SAP Fiori application for intelligent invoice processing powered by OData V4, ABAP RAP, and AI integration.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {},
  "devDependencies": {
    "@ui5/cli": "^3.0.0",
    "@sap/ux-ui5-tooling": "1.19.6",
    "@sap-ux/ui5-middleware-fe-mockserver": "2"
  },
  "scripts": {
    "start": "fiori run --open \"test/flp.html#app-preview\"",
    "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "build:cf": "node scripts/build-cf.mjs",
    "deploy": "fiori verify",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "fiori run --open \"index.html?sap-ui-xx-viewCache=false\"",
    "start-mock": "fiori run --config ./ui5-mock.yaml --open \"test/flp.html#app-preview\"",
    "int-test": "fiori run --config ./ui5-mock.yaml --open 'test/integration/opaTests.qunit.html'",
    "start-variants-management": "fiori run --open \"preview.html#app-preview\"",
    "unit-test": "fiori run --config ./ui5-mock.yaml --open 'test/unit/unitTests.qunit.html'",
    "serve-mock": "fiori run --config ./ui5-mock.yaml --port 8085",
    "test:unit": "node scripts/browser-test.mjs qunit http://localhost:8085/test/unit/unitTests.qunit.html",
    "test:opa": "node scripts/browser-test.mjs qunit http://localhost:8085/test/integration/opaTests.qunit.html",
    "test:runner": "node --test scripts/local-cap-auth.test.mjs scripts/cf-network.test.mjs",
    "test:cf-build": "node --test scripts/build-cf.test.mjs",
    "test": "npm run test:unit && npm run test:opa",
    "serve:inbox": "node scripts/prepare-inbox-local.mjs && fiori run --config ./ui5-inbox.yaml --port 8087",
    "test:inbox": "node scripts/browser-test.mjs qunit http://localhost:8087/test/integration/inboundCap.qunit.html",
    "test:inbox:e2e": "node scripts/inbox-e2e.mjs"
  },
  "sapuxLayer": "CUSTOMER_BASE"
}
