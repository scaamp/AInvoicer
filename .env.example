# AInvoicer — publiczna mapa srodowiska SAP BTP / CAP Java (bez sekretow)
#
# WERSJONOWANE W GIT: tylko niepoufne wartosci i puste pola do weryfikacji.
# NIE wpisuj tutaj hasel, tokenow CF/KSeF, service keys, VCAP_SERVICES, certyfikatow,
# H01_USER/H01_PASSWORD ani prawdziwych danych dokumentow.
#
# UWAGA: plik jest REFERENCYJNY. CF CLI, Maven, CAP Java, MTA i PowerShell
# NIE wczytuja automatycznie .env.example. Zrodla wykonawcze to m.in.
# mta.yaml, deploy/*.mtaext, cap-java/.cdsrc.json i application.yaml.
# Zmiana tego pliku sama w sobie niczego nie wdraza ani nie konfiguruje w BTP.

# --- Cloud Foundry / SAP BTP (potwierdzone logowaniem CF CLI) ---
CF_API_ENDPOINT=https://api.cf.eu20-001.hana.ondemand.com
CF_ORG=
CF_SPACE=dev
BTP_REGION=eu20
# CF_ORG: uzupelnij WYLACZNIE po odczycie z 'cf orgs' / 'cf target'.
# Nazwa org moze miec spacje: w PowerShell cytuj wartosc.
# Przyklad: cf login -a https://api.cf.eu20-001.hana.ondemand.com --sso
# Przyklad: cf target -o "<nazwa org z cf orgs>" -s dev

# --- MTA / aplikacje Cloud Foundry (mta.yaml + deploy/btp-dev-eu20*.mtaext) ---
MTA_ID=ainvoicer
MTA_EXTENSION=deploy/btp-dev-eu20-hana-first.mtaext
AINV_HOST_PREFIX=ainvoicer-v2xzij9s
CAP_APP=ainvoicer-srv
APPROUTER_APP=ainvoicer-approuter
HDI_DEPLOYER_APP=ainvoicer-db-deployer
# MTA_EXTENSION wskazuje istniejacy wariant first-HANA; NIE jest zgoda na deployment.
# Rozszerzenie pinuje historycznie cflinuxfs4 — aktualny stack sprawdz w CF.

# --- HANA Cloud / HDI (istniejace zasoby, bez nowego provisioningu) ---
HANA_INSTANCE=ainvoicer-hana-dev
HDI_SERVICE=ainvoicer-db
HDI_SERVICE_OFFERING=hana
HDI_SERVICE_PLAN=hdi-shared
HANA_DATABASE_ID=
# HANA_DATABASE_ID: Database ID z HANA Cloud Central (nie GUID uslugi CF).
# Nie jest potrzebny do uzycia juz istniejacego kontenera; bez potrzeby go nie uzupelniaj.

# --- Uslugi i destinations BTP (nazwy z mta.yaml) ---
XSUAA_SERVICE=ainvoicer-auth
DESTINATION_SERVICE=ainvoicer-destination
DESTINATION_H01=AINV_H01
DESTINATION_H01_UI_USER=AINV_H01_UI_USER

# --- CAP Java / sciezki i profil runtime ---
CAP_PROJECT_DIR=cap-java
CAP_DB_MODEL_DIR=cap-java/db
CAP_SRV_MODULE_DIR=cap-java/srv
CAP_SERVICE_PATH=/odata/v4/KsefService/
SPRING_PROFILES_ACTIVE=cf
SPRING_SQL_INIT_MODE=never
# Profil cf wymaga poprawnego XSUAA i bindingu HANA; H2 nie jest dowodem persystencji HANA.
# Trasy i bindingi sa konfigurowane przez MTA, nie przez ten plik.

# --- Bezpieczne przelaczniki (referencja; workflow KSeF pozostaje OFF) ---
AINV_KSEF_ENABLED=false
AINV_KSEF_INBOUND_ENABLED=false
AINV_SAP_WRITE_ENABLED=false
AINV_SAP_WRITE_SWEEPER_ENABLED=false
AINV_KSEF_STORAGE_PROVIDER=off
AINV_DEPLOYMENT_IDENTITY_SMOKE=false
# AINV_DEPLOYMENT_HANA_READINESS=true jest ustawiane tylko w specjalnym wariancie readiness,
# po osobnym zatwierdzeniu deploymentu (patrz docs/guides/CAP_HANA_01_FIRST_DEPLOYMENT_RUNBOOK.md).

# --- Zmienne wymagajace lokalnej/poufnej konfiguracji (NIE wpisuj tu wartosci) ---
# AINV_KSEF_NIP=               # kontekst, gdy potrzebny
# AINV_KSEF_TOKEN=             # sekret! poza Git / menedzer sekretow
# AINV_KSEF_LOCAL_STORE=       # tylko lokalna konfiguracja
# H01_URL=                     # lokalnie: cap-java/.env.live
# H01_USER=                    # sekret/dane dostepowe
# H01_PASSWORD=                # sekret!
# VCAP_SERVICES=               # przydzielane przez Cloud Foundry, NIGDY w repo

# Dalsze informacje: docs/guides/HANA_CLOUD_CAP_DEPLOYMENT.md
# i docs/guides/BTP_FIRST_DEPLOYMENT_RUNBOOK.md.
